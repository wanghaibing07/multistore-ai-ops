# In a container, use a reachable HTTPS model URL; leave blank to disable AI.
MULTISTORE_MODEL_URL=
MULTISTORE_MODEL_API_KEY=
MULTISTORE_MODEL_NAME=
# Replace with a DNS name pointing to the deployment host before exposing it.
CADDY_SITE=localhost

# Set to 1 for a remotely reachable instance; this disables quick login.
MULTISTORE_PUBLIC_MODE=0
MULTISTORE_QIANNIU_URL=https://myseller.taobao.com/home.htm/SellManage/orders
MULTISTORE_CARD_SITE_URL=https://www.16688.com.cn/
# Optional: where the local app looks for a recently downloaded Qianniu export.
MULTISTORE_DOWNLOADS_DIR=
