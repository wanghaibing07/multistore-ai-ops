# 16688 开放平台凭证（严禁提交到版本库）
PLATFORM_16688_APP_ID=your_16688_app_id
PLATFORM_16688_SECRET=your_64_hex_secret

# Canboso 买家 API Key（多 Key = 多供货商，按需增减）
CANBOSO_KEY_PRIMARY=tgb_your_primary_buyer_key
CANBOSO_KEY_SECONDARY=tgb_your_secondary_buyer_key

# 可选：投诉 / 熔断 / 余额预警 Webhook（留空则仅输出控制台和本地事件表）
ALERT_WEBHOOK_URL=

# 可选：QQ 邮箱 / SMTP 告警（配合 config 中的 runtime.alert_email.enabled: true）
ALERT_EMAIL_USER=your_qq@qq.com
ALERT_EMAIL_PASSWORD=your_16_char_smtp_auth_code
ALERT_EMAIL_TO=your_qq@qq.com
