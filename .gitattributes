# Normalize line endings across Windows and Linux CI
* text=auto eol=lf

# Shell scripts and Git hooks must stay LF
*.sh text eol=lf
.githooks/* text eol=lf

# Windows scripts keep CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.mp4 binary
*.woff binary
*.woff2 binary
*.ttf binary
*.db binary
*.sqlite binary
*.sqlite3 binary
*.xlsx binary
*.pdf binary
